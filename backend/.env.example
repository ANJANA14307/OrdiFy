# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your_service_role_key_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Google Generative AI Configuration
GEMINI_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Environment
ENVIRONMENT=development

# CORS Configuration
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Public catalog URL base (deployed Flutter web app origin)
PUBLIC_CATALOG_BASE_URL=https://your-deployed-app.example
PUBLIC_API_BASE_URL=https://your-api.example

# Razorpay Configuration (if using)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
RAZORPAY_CALLBACK_URL=https://your-deployed-app.example/payment-success

# Stripe Configuration (optional)
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Cloudinary Configuration (if using image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Instagram Integration (if using)
INSTAGRAM_ACCESS_TOKEN=your_instagram_token
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_account_id
META_APP_ID=your_meta_app_id
VERIFY_TOKEN=choose_a_long_random_meta_webhook_verification_token
META_APP_SECRET=your_meta_app_secret

# WhatsApp Cloud API (if using)
WHATSAPP_ACCESS_TOKEN=your_whatsapp_cloud_api_access_token
WHATSAPP_VERIFY_TOKEN=choose_a_long_random_webhook_verification_token

# Email (optional)
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=OrdiFy <orders@your-verified-domain.example>
